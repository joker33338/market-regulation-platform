# Loaded through process environment only; no credentials are bundled.
# PG_DSN=
EMBEDDING_BACKEND=local
EMBEDDING_MODEL_PATH=models/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_MAX_TOKENS=2048
# Optional OpenAI-compatible embedding service:
# API_BASE=
# API_KEY=
EMBED_MODEL=bge-m3-mlx-8bit
# Optional generation service:
# LLM_MODEL=

# Optional document parsing API. The existing local CLI remains independent.
MINERU_ENABLED=0
MINERU_MODE=mock
# self_hosted uses 4.1 Tasks; official uses public v4 precision API.
MINERU_PROVIDER=self_hosted
MINERU_CLOUD_MODEL=vlm
# Remote mode requires an explicit approved company endpoint; HTTPS by default.
MINERU_API_URL=
MINERU_API_KEY=
# MINERU_TOKEN is accepted as an alternative credential name for official tooling.
MINERU_TIER=standard
MINERU_CONNECT_TIMEOUT=5
MINERU_REQUEST_TIMEOUT=60
MINERU_POLL_INTERVAL=2
MINERU_MAX_POLLS=150
MINERU_MAX_UPLOAD_RETRIES=2
MINERU_MAX_DOWNLOAD_RETRIES=2
MINERU_OUTPUT_FORMATS=default
MINERU_RESULT_DIR=local/mineru
MINERU_ALLOWED_ORIGINS=
MINERU_ALLOW_HTTP=0
MINERU_CONCURRENCY=1
MINERU_QUEUE_SIZE=20
# Required JSON mapping of independent application bearer tokens to user IDs.
# Supply strong tokens through a secret manager; never commit real values.
PARSING_API_TOKENS_JSON={}
# Explicit opt-in: existing document_review schema only, never auto-migrated.
PARSING_RESULT_PG_DSN=

