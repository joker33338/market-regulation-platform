# 仅从进程环境加载配置，不附带真实凭据。
# PG_DSN=
EMBEDDING_BACKEND=local
EMBEDDING_MODEL_PATH=models/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_MAX_TOKENS=2048
# 可选的 OpenAI 兼容向量服务：
# API_BASE=
# API_KEY=
EMBED_MODEL=bge-m3-mlx-8bit
# 可选的文本生成服务：
# LLM_MODEL=

# 文档解析 API 为可选入口，原有本地 CLI 保持独立。
MINERU_ENABLED=0
MINERU_MODE=mock
# self_hosted 使用 4.1 Tasks，official 使用官网公开 v4 API。
MINERU_PROVIDER=self_hosted
MINERU_CLOUD_MODEL=vlm
# 远程模式须显式配置获准端点，默认要求 HTTPS。
MINERU_API_URL=
MINERU_API_KEY=
# 官网工具同时接受 MINERU_TOKEN 作为凭据变量名。
MINERU_TIER=standard
MINERU_CONNECT_TIMEOUT=5
MINERU_REQUEST_TIMEOUT=60
MINERU_POLL_INTERVAL=2
MINERU_MAX_POLLS=150
MINERU_MAX_UPLOAD_RETRIES=2
MINERU_MAX_DOWNLOAD_RETRIES=2
MINERU_OUTPUT_FORMATS=default
MINERU_RESULT_DIR=local/mineru
MINERU_ALLOWED_ORIGINS=
MINERU_ALLOW_HTTP=0
MINERU_CONCURRENCY=1
MINERU_QUEUE_SIZE=20
# 必须提供应用访问码到用户 ID 的独立 JSON 映射。
# 通过私密配置提供强访问码，禁止提交真实凭据。
PARSING_API_TOKENS_JSON={}
# 须显式启用，仅使用既有 document_review，不自动迁移。
PARSING_RESULT_PG_DSN=

# 双引擎须显式启用，本地优先，云端默认关闭。
DUAL_OCR_ENABLED=0
DUAL_OCR_CLOUD_ENABLED=0
# 服务端私密 JSON 映射：用户 -> 文件 SHA256 -> 授权记录。
DUAL_OCR_GRANTS_FILE=
DUAL_OCR_MAX_FALLBACKS=1
DUAL_OCR_MAX_CLOUD_CALLS=8
DUAL_OCR_MAX_TASK_CALLS=32
DUAL_OCR_MAX_CLOUD_FILES=2
DUAL_OCR_MAX_CLOUD_PAGES=50
DUAL_OCR_LOW_CONFIDENCE=0.8
DUAL_OCR_MIN_PAGE_CHARACTERS=12
DUAL_OCR_MAX_INVALID_RATIO=0.02

